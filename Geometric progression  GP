import java.util.Scanner;

public class GPSeries {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int first = sc.nextInt();
        int ratio = sc.nextInt();
        int n = sc.nextInt();

        int term = first;

        for (int i = 0; i < n; i++) {
            System.out.print(term + " ");
            term *= ratio;
        }
    }
}
