import java.util.Scanner;
class main{
    public static void main(String args[]){
        
        Scanner sc = new Scanner(System.in);
        System.out.println("enter number of lines");
        int n = sc.nextInt();
        

for (int i = 1; i <= n; i++) {

    // spaces
    for (int j = 1; j <= n - i; j++) {
        System.out.print(" ");
    }

    // numbers
    for (int j = 1; j <= i; j++) {
        System.out.print("* ");
    }

    System.out.println();
}
        }
}

/// Inverted pyramid

import java.util.Scanner;
class main{
    public static void main(String args[]){
        
        Scanner sc = new Scanner(System.in);
        System.out.println("enter number of lines");
        int n = sc.nextInt();
        

for (int i = n; i >= 1; i--) {

    // spaces
    for (int j = 1; j <= n - i; j++) {
        System.out.print(" ");
    }

    // numbers
    for (int j = 1; j <= 2 * i - 1; j++) {
        System.out.print("*");
    }

    System.out.println();
}
        }
        
        


}
