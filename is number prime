import java.util.Scanner;
class main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        System.out.println("enter a number");
        int p = sc.nextInt();
        
        Boolean isPrime = true;
        if (p <=1){
            isPrime = false;
        }else{
            for(int i = 2;i< p; i++){
                if( p % i ==0){
                    isPrime = false;
                    break;
                }
            }
        }
        if (isPrime){
            System.out.println("prime");
        }else{
            System.out.println(" not prime");
        }
    }
}
