/////method overriding = runtime time polymorphism
class main{
    public static void main(String[]args){
     
     Animal a1 = new Dog();
     Animal a2 = new Cat();
     
     a1.sound();
     a2.sound();
    }
}

class Animal{
    void sound(){
        System.out.println("Animals make sound");
    }
}
class Dog extends Animal{
    @Override
    void sound(){
        System.out.println("Dogs bark");
    }
}
class Cat extends Animal{
    @Override
    void sound(){
        System.out.println("cats meow");
    }
}



######### method overloading
//method overloading, compile time polymorphism


public class main{
    public static void main(String[]args){
        
        calci c = new calci();
        System.out.println(c.add( 100, 200));
        System.out.println(c.add( 100, 200 , 200));
        System.out.println(c.add( 1.9, 2.1));

    }
}
class calci{
    int add(int a, int b){
        return a + b;
    }
    int add(int a , int b , int c){
        return a + b +c;
    }
    double add(double a , double b){
        return a+b ;
    }
}


