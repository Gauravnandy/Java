Word Scramble

you are running a class and suspect that some of ur students are passing around the answers to mcq disguised as random strings.
Given a list of words and a string , find which word on the list is crambled ip inside the string ,if any . There will be at most one matching word. the lettes dont need to be contiguous.

Question:  after catching ur class students cheating before , you realize ur students are getting craftieer and hiding words in 3d grid of lettrs . 
the word may start anywhere in the grid and conscutive letters can be either immediately  below or to the right of the previous letter.
given a grid and a word , write a function that retuens the location of the word in the grid as a list of coordinates . if there are multiple matches ,return any one


Code;

import java.util.*;
class Main{
    static List<int[]> path = new ArrayList<>();
    public static void main(String []args){
        char [][] grid ={
            {'C', 'A','K'},
            {'P', 'T', 'L'},
            {'H', 'B', 'W'}
        };
        String word = "CAT";
        List<int[]> result = findWord(grid , word);   // calls findWord() and stores returned coordinates 
        if(result.isEmpty()){  // checks if no word was found
            System.out.println("word not found"); // print if list is empty
        }else{
            for(int[] p : result){  // loop through coordinate list
                System.out.println("(" + p[0] + "," + p[1] +")");
            }
        }
        
    }  //Function that searches the whole grid.
    static List<int[]> findWord(char[][] grid, String word){
        int rows = grid.length;       // gets number of rows
        int columns = grid[0].length; // gets number of columns
        for(int i=0 ; i<rows; i++){  //Iterates row by row.
            for(int j = 0; j < columns; j++){  //Iterates column by column.
                
                path = new ArrayList<>();
                // Try current cell as starting point.
                if(dfs(grid, word,i, j, 0)){
                    return path;
                }
            }
        }
        return new ArrayList<>();
    } // Parameters:row → current row  col → current column  index → current character position
    static boolean dfs(char[][] grid , String word, int row ,int col ,
    int index){
        if (index == word.length()){
            return true; /// word found
        } 
        // boundary check
        if(row < 0 || row >= grid.length || col <0 || col >= grid[0].length){
            return false;
        }
        //Compare current grid character with expected word character.
        if(grid[row][col] != word.charAt(index)){
            return false;
        }
        // store coordinate
        path.add(new int[]{row, col});
        // if right path succeeds stop
        if(dfs(grid, word,  row, col+1 , index+1)){
            return true;
        }
                // if down path succeeds stop
        if(dfs(grid, word, row+1, col, index+1)){
            return true;
        }
        // backtracking
        path.remove(path.size ()-1);
        return false;
    }
    
}
